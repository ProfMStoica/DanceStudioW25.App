<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DanceStudio.DanceFloorPage"
             Title="Dance Floor">
    <Grid RowDefinitions="*, Auto" ColumnDefinitions="Auto, *, Auto">
        <!-- The dance floor layout with a border-->
        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" 
                StrokeThickness="2" 
                Margin="20">
            <AbsoluteLayout x:Name="_alDanceFloor">
                <Image x:Name="_imgAvatar"
                       Source="homer_simpson.gif"
                       AbsoluteLayout.LayoutBounds="0.5, 0.5"
                       AbsoluteLayout.LayoutFlags="PositionProportional"/>
            </AbsoluteLayout>
        </Border>
        
        <!-- The Up/Left controls-->
        <VerticalStackLayout Grid.Row="1" Grid.Column="0"
                             VerticalOptions="Start"
                             Margin="20"
                             Spacing="10">
            <Button x:Name="_btnUp" Text="Up" FontSize="17" WidthRequest="95"
                    Clicked="OnDanceMove"/>
            <Button  x:Name="_btnLeft" Text="Left" FontSize="17" WidthRequest="95" 
                     Clicked="OnDanceMove"/>
        </VerticalStackLayout>
        
        <!-- The Rotate/Load controls-->
        <VerticalStackLayout Grid.Row="1" Grid.Column="1"
                             Margin="20"
                             Spacing="10"
                             WidthRequest="200">
            <HorizontalStackLayout Spacing="10" >
                <Button x:Name="_btnRotateLeft" Text="R-Left" FontSize="17" WidthRequest="95"
                        Clicked="OnDanceMoveRotate"/>
                <Button x:Name="_btnRotateRight" Text = "R-Right" FontSize="17"  WidthRequest="95"
                        Clicked="OnDanceMoveRotate"/>
            </HorizontalStackLayout>
            <Button x:Name="_btnStartDancing" Text="Start Dancing" FontSize="17"
                    Clicked="OnStartDancing"/>
        </VerticalStackLayout>
        
        <!-- The Down/Right controls-->
        <VerticalStackLayout Grid.Row="1" Grid.Column="2"
                             VerticalOptions="End"
                             Margin="20"
                             Spacing="10">
            <Button  x:Name="_btnDown" Text="Down" FontSize="17"  WidthRequest="95"  
                     Clicked="OnDanceMove"/>
            <Button   x:Name="_btnRight" Text="Right" FontSize="17" WidthRequest="95"
                      Clicked="OnDanceMove"/>
        </VerticalStackLayout>        
    </Grid>
</ContentPage>